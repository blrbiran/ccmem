{
  "name": "ccmem",
  "version": "0.13.1",
  "private": true,
  "type": "module",
  "bin": {
    "ccmem": "./bin/ccmem"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2",
    "openai": "^4.104.0"
  },
  "scripts": {
    "test": "env -u CCMEM_CONFIG_PATH CCMEM_DATA_ROOT=\"$(mktemp -d)\" /usr/local/bin/node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:unit": "env -u CCMEM_CONFIG_PATH CCMEM_DATA_ROOT=\"$(mktemp -d)\" /usr/local/bin/node --test tests/unit/*.test.mjs",
    "test:integration": "env -u CCMEM_CONFIG_PATH CCMEM_DATA_ROOT=\"$(mktemp -d)\" /usr/local/bin/node --test tests/integration/*.test.mjs"
  }
}
